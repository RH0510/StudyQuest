# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/?retryWrites=true&w=majority
DB_NAME=studyquest

# Long random secret used to sign login sessions (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret

PORT=3000
NODE_ENV=development

# Pomodoro lengths in minutes. Keep 25 and 5 for submission (SRS FR-16).
FOCUS_MINUTES=25
BREAK_MINUTES=5

# Failed login attempts allowed per IP address in 15 minutes (Section 4.8)
LOGIN_RATE_LIMIT=5

# Separate database used only by "npm test"
TEST_MONGODB_URI=
